{
  "name": "@invade/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:api": "esbuild server/vercel.ts --bundle --platform=node --format=esm --target=node20 --legal-comments=none --outfile='api/[route].js' --banner:js=\"// GENERATED by npm run build:api from server/vercel.ts. Do not edit.\nimport { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@invade/engine": "*",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.16.3",
    "@supabase/supabase-js": "2.47.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "three": "^0.170.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.186.0",
    "@vercel/node": "3.2.29",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.21.5",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1",
    "vite": "5.4.21",
    "vitest": "2.1.8"
  }
}
